# ---------------------------------------------------------------------------
# Rafiq HR agent — environment
#
# Copy to .env and fill in only what you need. THE AGENT RUNS WITH NONE OF
# THESE SET: both integrations default to local fixture stores, so a fresh
# clone works end to end with no accounts at all.
#
# Sandbox values go in .env. Production values go on the server via `lua env`.
# ---------------------------------------------------------------------------


# --- HRIS (BambooHR) -------------------------------------------------------
# fixture (default) = in-memory HRIS seeded from fixtures/hris.ts
# live              = real BambooHR
HRIS_MODE=fixture

# The subdomain in https://{domain}.bamboohr.com — not the whole URL.
BAMBOOHR_COMPANY_DOMAIN=
# Generate from your BambooHR user menu, or Settings > Account > API Keys.
# The key inherits the permissions of the user who created it, so create it as
# a service user with the access the agent actually needs and no more.
BAMBOOHR_API_KEY=
# Optional. Defaults to the gateway form:
#   https://api.bamboohr.com/api/gateway.php/{domain}/v1
BAMBOOHR_BASE_URL=
# Name of the custom field holding Iqama / Emirates ID expiry. Custom fields
# cannot be created through the API, so this must already exist in the tenant.
BAMBOOHR_PERMIT_FIELD=customIqamaExpiry


# --- HR Ops sheet (Google Sheets) -----------------------------------------
# fixture (default) = local JSON store at .local/ops-sheet.json
# live              = real Google Sheets
SHEETS_MODE=fixture

# The segment between /d/ and /edit in the spreadsheet URL, not the whole URL.
GOOGLE_SHEETS_ID=

# Credentials, in order of preference. Use the base64 form: it is the only one
# where a newline in the private key cannot be mangled in transit.
#   bash:       base64 -w0 key.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GOOGLE_SERVICE_ACCOUNT_B64=

# Alternatives, if you cannot use the base64 form:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_PRIVATE_KEY_ID=

# Remember: enabling the Sheets API grants your PROJECT access to the API. It
# grants the service account nothing. You must also share the spreadsheet with
# the service account's client_email as an Editor. A 403 here is almost always
# that step being missed.


# --- Local fixture store ---------------------------------------------------
# Where the fixture Sheets client persists. Delete the file to reset a demo.
SHEETS_FIXTURE_PATH=.local/ops-sheet.json
